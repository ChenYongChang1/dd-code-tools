{
  "name": "@dd-code/babel-tools",
  "version": "0.0.3",
  "description": "Babel plugin to extract and replace Chinese literals with i18n keys",
  "main": "./dist/index.esm.js",
  "module": "./dist/index.esm.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js"
    }
  },
  "scripts": {
    "dev": "rollup -c --watch",
    "build": "rollup -c",
    "clean": "rimraf dist"
  },
  "peerDependencies": {
    "@babel/generator": ">=7.28.3",
    "@babel/parser": ">=7.28.4",
    "@babel/preset-typescript": ">=7.27.1",
    "@babel/traverse": ">=7.28.4",
    "@babel/types": ">=7.28.4"
  },
  "devDependencies": {
    "@babel/generator": "^7.28.3",
    "@babel/parser": "^7.28.4",
    "@babel/preset-typescript": "^7.27.1",
    "@babel/traverse": "^7.28.4",
    "@babel/types": "^7.28.4",
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.4",
    "@types/babel__generator": "^7.27.0",
    "rimraf": "^3.0.2",
    "rollup": "^4.52.0",
    "rollup-plugin-dts": "^6.2.3",
    "typescript": "^5.4.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "ISC",
  "keywords": [
    "babel-plugin",
    "i18n",
    "internationalization",
    "extract",
    "translate"
  ]
}
