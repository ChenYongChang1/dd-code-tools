{
  "name": "@dd-code/vite-tools",
  "version": "1.1.2",
  "description": "Vite-specific tools and utilities",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "plugins.js",
    "plugins.d.ts",
    "web.js",
    "web.d.ts",
    "README.md",
    "CHNAGELOG.md"
  ],
  "bin": {
    "@dd-code/vite-tools": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js"
    },
    "./plugins": {
      "types": "./dist/plugins.d.ts",
      "import": "./dist/plugins.esm.js",
      "require": "./dist/plugins.cjs.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/web.esm.js",
      "require": "./dist/web.cjs.js"
    }
  },
  "scripts": {
    "dev": "rollup -c --watch",
    "build": "rollup -c",
    "clean": "rm -rf dist",
    "jest": "jest"
  },
  "dependencies": {
    "@dd-code/babel-tools": "workspace:*",
    "@dd-code/shared": "workspace:*",
    "cli-progress": "^3.12.0"
  },
  "publishConfig": {
    "dependencies": {
      "@dd-code/shared": "latest",
      "@dd-code/babel-tools": "latest"
    }
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "@vue/compiler-sfc": "^3.5.22",
    "dom-serializer": "^2.0.0",
    "htmlparser2": "^10.0.0",
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.4",
    "rollup": "^4.52.0",
    "rollup-plugin-dts": "^6.2.3",
    "tslib": "^2.8.1",
    "typescript": "^4.9.5",
    "@types/babel__generator": "^7.27.0",
    "vite": "6.0.6"
  },
  "peerDependencies": {
    "vite": ">=4.0.0",
    "@vue/compiler-sfc": ">=3.5.22",
    "dom-serializer": ">=2.0.0",
    "htmlparser2": ">=10.0.0"
  },
  "keywords": [
    "vite",
    "tools",
    "utilities"
  ],
  "author": "",
  "license": "ISC"
}
