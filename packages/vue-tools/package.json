{
  "name": "@chagee/vue-tools",
  "version": "0.0.1",
  "description": "vue-specific tools and utilities",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "bin": {
    "@chagee/vue-tools": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js"
    },
    "./plugins": {
      "types": "./dist/plugins.d.ts",
      "import": "./dist/plugins.esm.js",
      "require": "./dist/plugins.cjs.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/web.esm.js",
      "require": "./dist/web.cjs.js"
    }
  },
  "scripts": {
    "dev": "rollup -c --watch",
    "build": "rollup -c",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@babel/core": "^7.28.4",
    "@babel/parser": "^7.28.4",
    "@babel/traverse": "^7.28.4",
    "@babel/preset-typescript": "^7.27.1",
    "@chagee/chain-shared": "workspace:*",
    "@chagee/vite-tools": "workspace:*"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.4",
    "rollup": "^4.52.0",
    "rollup-plugin-dts": "^6.2.3",
    "tslib": "^2.8.1",
    "typescript": "^4.9.5",
    "vite": "6.0.6"
  },
  "peerDependencies": {
    "vite": ">=4.0.0",
    "@babel/preset-typescript": ">=7.27.1"
  },
  "keywords": [
    "vite",
    "tools",
    "utilities"
  ],
  "author": "",
  "license": "ISC"
}
